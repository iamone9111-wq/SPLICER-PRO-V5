<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#050811">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPLICER PRO"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi-Device Video Wall &amp; Screen Splicing Studio"
            android:textColor="#818CF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose your role to start or join a multi-device video wall"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Role Option 1: Host -->
        <LinearLayout
            android:id="@+id/btnHostCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card_accent"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 I am a Host (Master)"
                android:textColor="#A5B4FC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create video wall, load local video, configure multi-screen matrix, and broadcast real-time lockstep synchronization to all client phones."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnHost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Select Host Master"
                android:background="@drawable/bg_glass_button_primary"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Role Option 2: Join Screen -->
        <LinearLayout
            android:id="@+id/btnJoinCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Join Screen (Client)"
                android:textColor="#34D399"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display sliced synchronized video. Connects directly to Host device. Screen automatically pauses if Host disconnects."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Auto-Discovery Status Badge -->
            <TextView
                android:id="@+id/tvAutoDiscoveryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 Searching for Host on local network..."
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:background="@drawable/bg_glass_pill"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnUseHotspotIp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="⚡ Use Hotspot (192.168.43.1)"
                    android:textSize="11sp"
                    android:background="@drawable/bg_glass_button_secondary"
                    android:textColor="#38BDF8"
                    android:padding="0dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputHostIp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Host IP (e.g. 192.168.43.1 or 192.168.1.x)"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:background="@drawable/bg_glass_pill"
                android:paddingHorizontal="16dp"
                android:inputType="textUri"
                android:textSize="13sp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnJoin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Join Video Wall"
                android:background="@drawable/bg_glass_button_primary"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
