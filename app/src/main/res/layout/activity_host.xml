<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TextureView for hardware video decoding / rendering -->
    <TextureView
        android:id="@+id/hostTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. SETTINGS & CONFIGURATION INTERFACE -->
    <ScrollView
        android:id="@+id/hostSettingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050811"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header & Role Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👑 Host Master Control"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnChangeRole"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Change Role"
                    android:textSize="12sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#CBD5E1" />
            </LinearLayout>

            <!-- LIVE WALL PREVIEW SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0B1021"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LIVE WALL MATRIX PREVIEW"
                        android:textColor="#818CF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveWallDimensions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1R × 1C (1 SCREEN)"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Grid Visual Representation -->
                <LinearLayout
                    android:id="@+id/liveWallGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:background="#050811"
                    android:padding="6dp"
                    android:layout_marginBottom="12dp" />

                <!-- PLAY IMMERSION & PAUSE BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnPlayImmersion"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="▶ START IMMERSION PLAYBACK"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#10B981"
                        android:textColor="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnPauseImmersion"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_pause"
                        android:background="@drawable/bg_control_button"
                        android:contentDescription="Pause Immersion Playback"
                        android:scaleType="centerInside"
                        android:padding="12dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- FLASH SCREENS BUTTON -->
                <Button
                    android:id="@+id/btnFlashScreens"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="💡 FLASH SCREENS (SHOW SCREEN NUMBERS)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#4F46E5"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>

            <!-- Video Selector Card with Device File and YouTube URL options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080D1E"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VIDEO SOURCE"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Tab Switcher -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTabDeviceVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="📁 Device File"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:backgroundTint="#4F46E5"
                            android:textColor="#FFFFFF"
                            android:paddingHorizontal="10dp" />

                        <Button
                            android:id="@+id/btnTabYoutube"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="🔴 YouTube URL"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:backgroundTint="#1E293B"
                            android:textColor="#94A3B8"
                            android:paddingHorizontal="10dp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: Local Device File Selection -->
                <LinearLayout
                    android:id="@+id/layoutDeviceVideoSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnSelectVideo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="🎬 Select Video File from Device (MP4/MKV)"
                        android:backgroundTint="#4F46E5"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- SECTION 2: YouTube / Online Video URL Input -->
                <LinearLayout
                    android:id="@+id/layoutYoutubeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <EditText
                            android:id="@+id/etYoutubeUrl"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:hint="Paste YouTube or video link (https://...)"
                            android:textColorHint="#475569"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:background="#0F172A"
                            android:paddingHorizontal="10dp"
                            android:singleLine="true"
                            android:imeOptions="actionDone" />

                        <Button
                            android:id="@+id/btnPasteYoutube"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="📋 Paste"
                            android:textSize="11sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#38BDF8"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp" />

                        <Button
                            android:id="@+id/btnClearYoutube"
                            android:layout_width="38dp"
                            android:layout_height="44dp"
                            android:text="✕"
                            android:textSize="12sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#94A3B8"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnLoadYoutube"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="⚡ Load &amp; Sync YouTube to All Screens"
                        android:backgroundTint="#DC2626"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <!-- Preset Quick Test Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Samples:"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnPresetSample1"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="1080p Demo"
                            android:textSize="9sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#CBD5E1"
                            android:padding="0dp"
                            android:layout_marginEnd="3dp" />

                        <Button
                            android:id="@+id/btnPresetSample2"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="4K Sci-Fi"
                            android:textSize="9sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#CBD5E1"
                            android:padding="0dp"
                            android:layout_marginEnd="3dp" />

                        <Button
                            android:id="@+id/btnPresetSample3"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="Cyberpunk"
                            android:textSize="9sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#CBD5E1"
                            android:padding="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No video selected (Select a file or paste YouTube URL)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Row 1: Host IP + Connected Screens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Host IP Box -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HOST IP (HOTSPOT / LAN)"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRefreshHostIp"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="⟳"
                            android:textSize="11sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#38BDF8"
                            android:padding="0dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHostIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.43.1:8988"
                        android:textColor="#34D399"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHostNetworkStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clients connect to this IP • Hotspot Active"
                        android:textColor="#64748B"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Connected Devices Box -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONNECTED DEVICES"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConnectedScreensCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Screen Active (Host only)"
                        android:textColor="#818CF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Total Screens Stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080D1E"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL SCREENS COUNT"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnDecreaseScreens"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_minus"
                        android:background="@drawable/bg_control_button"
                        android:contentDescription="Decrease Screens"
                        android:scaleType="centerInside"
                        android:padding="10dp" />

                    <TextView
                        android:id="@+id/tvTotalScreensValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnIncreaseScreens"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_plus"
                        android:background="@drawable/bg_control_button"
                        android:contentDescription="Increase Screens"
                        android:scaleType="centerInside"
                        android:padding="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Grid Matrix (Rows & Columns) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Rows Control -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRID ROWS"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btnDecreaseRows"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_minus"
                            android:background="@drawable/bg_control_button"
                            android:contentDescription="Decrease Rows"
                            android:scaleType="centerInside"
                            android:padding="9dp" />

                        <TextView
                            android:id="@+id/tvRowsValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:gravity="center"
                            android:textColor="#818CF8"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncreaseRows"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_plus"
                            android:background="@drawable/bg_control_button"
                            android:contentDescription="Increase Rows"
                            android:scaleType="centerInside"
                            android:padding="9dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Cols Control -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRID COLUMNS"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btnDecreaseCols"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_minus"
                            android:background="@drawable/bg_control_button"
                            android:contentDescription="Decrease Columns"
                            android:scaleType="centerInside"
                            android:padding="9dp" />

                        <TextView
                            android:id="@+id/tvColsValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:gravity="center"
                            android:textColor="#818CF8"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncreaseCols"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_plus"
                            android:background="@drawable/bg_control_button"
                            android:contentDescription="Increase Columns"
                            android:scaleType="centerInside"
                            android:padding="9dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 4: Device Placement & Appearance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Device Placement (Vertical vs Horizontal) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEVICE PLACEMENT"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Button
                        android:id="@+id/btnDevicePlacement"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="Switch Orientation"
                        android:textSize="11sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#CBD5E1" />

                    <TextView
                        android:id="@+id/tvDevicePlacement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 Placed Horizontally (Landscape)"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Screen Appearance / Scaling -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APPEARANCE"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Button
                        android:id="@+id/btnAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="Toggle Fit"
                        android:textSize="11sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#CBD5E1" />

                    <TextView
                        android:id="@+id/tvAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="COVER (Full)"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 5: Mobile Bezel Compensation (Seamless Continuity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080D1E"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEZEL COMPENSATION (SEAMLESS WALL)"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnBezelCompensation"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Adjust Bezel"
                        android:textSize="11sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#CBD5E1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBezelCompensation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✨ Seamless Mobile Bezels (3.5%)"
                    android:textColor="#A78BFA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 2. IMMERSION CONTROLS (Floating HUD revealed during playback) -->
    <LinearLayout
        android:id="@+id/immersionOverlayControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DD090D1C"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <!-- Full Immersion Progress Bar -->
        <SeekBar
            android:id="@+id/immersionSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            android:splitTrack="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnImmersionRewind10"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_replay_10"
                android:background="@drawable/bg_control_button"
                android:contentDescription="Rewind 10s"
                android:scaleType="centerInside"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnFloatingPause"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="⏸ Pause"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

            <ImageButton
                android:id="@+id/btnImmersionForward10"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_forward_10"
                android:background="@drawable/bg_control_button"
                android:contentDescription="Forward 10s"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvImmersionTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00 / 00:00"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginHorizontal="8dp" />

            <Button
                android:id="@+id/btnImmersionFlash"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="💡 Flash"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnExitImmersion"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✕ Settings"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Screen Identification Flash Overlay on Host (Screen #1) -->
    <FrameLayout
        android:id="@+id/hostIdentifyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/tvHostIdentifyBigNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="96sp"
                android:textColor="#34D399"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOST SCREEN (1)"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
