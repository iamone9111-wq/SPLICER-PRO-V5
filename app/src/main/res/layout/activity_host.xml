<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TextureView for hardware video decoding / rendering -->
    <TextureView
        android:id="@+id/hostTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. SETTINGS & CONFIGURATION INTERFACE -->
    <ScrollView
        android:id="@+id/hostSettingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050811"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header & Role Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👑 Host Master Control"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnChangeRole"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Change Role"
                    android:textSize="12sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#CBD5E1" />
            </LinearLayout>

            <!-- LIVE WALL PREVIEW SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0B1021"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LIVE WALL MATRIX PREVIEW"
                        android:textColor="#818CF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveWallDimensions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1R × 1C (1 SCREEN)"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Grid Visual Representation -->
                <LinearLayout
                    android:id="@+id/liveWallGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:background="#050811"
                    android:padding="6dp"
                    android:layout_marginBottom="12dp" />

                <!-- PLAY IMMERSION & PAUSE BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnPlayImmersion"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="▶ START IMMERSION PLAYBACK"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#10B981"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnPauseImmersion"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="⏸"
                        android:textSize="18sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Video Selector Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080D1E"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIDEO SOURCE"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnSelectVideo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🎬 Select Video File from Device (MP4/MKV)"
                    android:backgroundTint="#4F46E5"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSelectedVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No video selected (Select a video to stream to all screens)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Row 1: Host IP + Connected Screens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Host IP Box -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOST IP (SOCKET)"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHostIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.43.1:8988"
                        android:textColor="#34D399"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Connected Devices Box -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONNECTED DEVICES"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConnectedScreensCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Screen Active (Host only)"
                        android:textColor="#818CF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Total Screens Stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080D1E"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL SCREENS COUNT"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnDecreaseScreens"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:text="-"
                        android:textSize="18sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvTotalScreensValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIncreaseScreens"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Grid Matrix (Rows & Columns) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Rows Control -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRID ROWS"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnDecreaseRows"
                            android:layout_width="38dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:textSize="16sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvRowsValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:gravity="center"
                            android:textColor="#818CF8"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnIncreaseRows"
                            android:layout_width="38dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="16sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Cols Control -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRID COLUMNS"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnDecreaseCols"
                            android:layout_width="38dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:textSize="16sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvColsValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:gravity="center"
                            android:textColor="#818CF8"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnIncreaseCols"
                            android:layout_width="38dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="16sp"
                            android:backgroundTint="#1E293B"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 4: Device Placement & Appearance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Device Placement (Vertical vs Horizontal) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEVICE PLACEMENT"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Button
                        android:id="@+id/btnDevicePlacement"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="Switch Orientation"
                        android:textSize="11sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#CBD5E1" />

                    <TextView
                        android:id="@+id/tvDevicePlacement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 Placed Horizontally (Landscape)"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Screen Appearance / Scaling -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#080D1E"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APPEARANCE"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Button
                        android:id="@+id/btnAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="Toggle Fit"
                        android:textSize="11sp"
                        android:backgroundTint="#1E293B"
                        android:textColor="#CBD5E1" />

                    <TextView
                        android:id="@+id/tvAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="COVER (Full)"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 2. IMMERSION CONTROLS (Floating top bar revealed during playback) -->
    <LinearLayout
        android:id="@+id/immersionOverlayControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC0B1021"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WALL PLAYING"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnFloatingPause"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⏸ Pause"
            android:textSize="12sp"
            android:backgroundTint="#1E293B"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnExitImmersion"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✕ Settings"
            android:textSize="11sp"
            android:backgroundTint="#5850EC"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
