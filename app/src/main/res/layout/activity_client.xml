<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="#000000">

    <TextureView
        android:id="@+id/clientTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Top Right Status / Screen Indicator -->
    <LinearLayout
        android:id="@+id/layoutClientStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_glass_pill"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_gravity="top|end">
        <TextView
            android:id="@+id/tvScreenIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to Host..."
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvSyncTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lockstep Sync: Active"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Large Screen Identification Flash Overlay -->
    <FrameLayout
        android:id="@+id/identifyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/tvIdentifyBigNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textSize="96sp"
                android:textColor="#38BDF8"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THIS SCREEN"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Connection Failure & Troubleshooting Overlay Card -->
    <FrameLayout
        android:id="@+id/cardConnectionError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3050811"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Host Disconnected"
                android:textColor="#F87171"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Host master device disconnected. Screen paused."
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Connection Tips:\n1. If connected to Host Mobile Hotspot, Host IP is ALWAYS 192.168.43.1.\n2. Ensure Host app is open and both phones are on same Wi-Fi/Hotspot."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:background="@drawable/bg_glass_pill"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnRetryHotspot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⚡ Try Hotspot IP (192.168.43.1)"
                android:background="@drawable/bg_glass_button_primary"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetryOriginal"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🔄 Reconnect"
                    android:background="@drawable/bg_glass_button_secondary"
                    android:textColor="#F8FAFC"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnBackToEnterIp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="⬅️ Change IP"
                    android:background="@drawable/bg_glass_button_secondary"
                    android:textColor="#F8FAFC"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
